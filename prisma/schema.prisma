generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// No auth — Postgres currently stores captured leads (newsletter / download
// signups) and is ready for progress sync if accounts are added later.
model Lead {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   // e.g. "newsletter", "practice-file-download"
  createdAt DateTime @default(now())
}

// Whop-authenticated users and their Pro access (monthly/lifetime variants).
model WhopUser {
  whopUserId   String   @id
  email        String?
  name         String?
  pro          Boolean  @default(false)
  membershipId String?
  syncedAt     DateTime @updatedAt
  createdAt    DateTime @default(now())
}
